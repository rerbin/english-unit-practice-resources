.","translation":"这是我的家庭。","audioResource":"u_085"},{"type":"sentence","text":"My father, my mother and I are in my family.","translation":"我的爸爸、妈妈和我组成我的家庭。","audioResource":"u_086"},{"type":"sentence","text":"I have a good friend.","translation":"我有一个好朋友。","audioResource":"u_088"},{"type":"sentence","text":"His or her name is ___.","translation":"他或她的名字是……","audioResource":"u_093"},{"type":"sentence","text":"We ___ together at school.","translation":"我们在学校一起……","audioResource":"u_094"},{"type":"sentence","text":"I love my family and my friends.","translation":"我爱我的家人和朋友。","audioResource":"u_092"}]}]},{"schema":"english-paper/v1","unitId":"4A-U1","title":"4A Unit 1 · My school","sections":[{"title":"一、语音 · Letter W","items":[{"type":"letter","text":"W","translation":"字母 w · 发 /w/","audioResource":"phoneme:w"},{"type":"sentence","text":"wall","translation":"墙","audioResource":"u_001"},{"type":"sentence","text":"we","translation":"我们","audioResource":"u_002"},{"type":"sentence","text":"window","translation":"窗户","audioResource":"u_003"},{"type":"sentence","text":"watch","translation":"手表","audioResource":"u_004"},{"type":"sentence","text":"work","translation":"工作","audioResource":"u_005"},{"type":"sentence","text":"week","translation":"星期","audioResource":"u_006"},{"type":"sentence","text":"water","translation":"水","audioResource":"u_007"},{"type":"sentence","text":"way","translation":"路；方式","audioResource":"u_008"},{"type":"sentence","text":"warm","translation":"暖和的","audioResource":"u_009"}],"description":"学习字母 w。w 发 /w/，读的时候双唇收圆向前突出，然后快速滑开，像吹蜡烛一样。"},{"title":"二、单词","items":[{"type":"sentence","text":"classroom","translation":"教室","audioResource":"u_010"},{"type":"sentence","text":"sports field","translation":"运动场","audioResource":"u_011"},{"type":"sentence","text":"hall","translation":"礼堂","audioResource":"u_012"},{"type":"sentence","text":"library","translation":"图书馆","audioResource":"u_013"},{"type":"sentence","text":"computer room","translation":"计算机机房","audioRe