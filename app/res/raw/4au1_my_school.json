e":"sentence","text":"school","translation":"学校","audioResource":"u_022"},{"type":"sentence","text":"teacher","translation":"老师","audioResource":"u_023"},{"type":"sentence","text":"student","translation":"学生","audioResource":"u_024"},{"type":"sentence","text":"bamboo","translation":"竹子","audioResource":"u_025"},{"type":"sentence","text":"wall","translation":"墙","audioResource":"u_001"},{"type":"sentence","text":"umbrella","translation":"雨伞","audioResource":"u_026"},{"type":"sentence","text":"boat","translation":"小船","audioResource":"u_027"},{"type":"sentence","text":"special","translation":"特别的","audioResource":"u_028"},{"type":"sentence","text":"lovely","translation":"令人愉快的；极好的","audioResource":"u_029"},{"type":"sentence","text":"cool","translation":"凉爽的；酷的","audioResource":"u_030"},{"type":"sentence","text":"tidy","translation":"整洁的","audioResource":"u_031"},{"type":"sentence","text":"project","translation":"课题","audioResource":"u_032"}]},{"title":"三、重点短语","items":[{"type":"sentence","text":"lovely and cool","translation":"既可爱又酷","audioResource":"u_033"},{"type":"sentence","text":"keep it tidy","translation":"保持它整洁","audioResource":"u_034"},{"type":"sentence","text":"do sports there","translation":"在那儿做运动","audioResource":"u_035"},{"type":"sentence","text":"the best of all","translation":"所有当中最好的","audioResource":"u_036"},{"type":"sentence","text":"play basketball","translation":"打篮球","audioResource":"u_037"},{"type":"sentence","text":"work on a project","translation":"做课题","audioResource":"u_038"},{"type":"sentence","text":"about the school history","translation":"关于学校历史","audioResource":"u_039"},{"type":"sentence","text":"shall we","translation":"我们……好吗","audioResource":"u_040"},{"type":"sentence","text":"go and look for","translation":"去寻找","audioResource":"u_041"},{"type":"sentence","text":"on the sports field","translation":"在运动场上","audioResource":"u_042"},{"type":"sentence","text":"on the ground floor","translation":"在一楼","audioResource":"u_043"},{"type":"sentence","text":"see you soon","translation":"一会儿见","audioResource":"u_044"},{"type":"sentence","text":"has no computers","translation":"没有电脑","audioResource":"u_045"},{"type":"sentence","text":"does not have any computers","translation":"没有任何电脑","audioResource":"u_046"},{"type":"sentence","text":"have no walls","translation":"没有墙","audioResource":"u_047"},{"type":"sentence","text":"do not have any walls","translation":"没有任何墙","audioResource":"u_048"},{"type":"sentence","text":"be made of","translation":"由……制成","audioResource":"u_049"},{"type":"sentence","text":"look like a boat","translation":"像一艘小船","audioResource":"u_050"},{"type":"sentence","text":"read many interesting books","translation":"读许多有趣的书","audioResource":"u_051"},{"type":"sentence","text":"my favourite place","translation":"我最喜爱的地方","audioResource":"u_052"}]},{"title":"四、课文重点句子 · 连读背诵","items":[{"type":"sentence","text":"I like my school. It is lovely and cool.","translation":"我喜欢我的学校。它又漂亮又棒。","audioResource":"u_053"},{"type":"sentence","text":"In the classroom I study. We always keep it tidy.","translation":"在教室里我学习。我们总是保持它整洁。","audioResource":"u_054"},{"type":"sentence","text":"On the sports field I play. We do sports there every day.","translation":"在运动场上我玩耍。我们每天在那里运动。","audioResource":"u_055"},{"type":"sentence","text":"In the hall I sing for all. The library is the best of all.","translation":"在礼堂里我为所有人唱歌。图书馆是所有地方中最好的。","audioResource":"u_056"},{"type":"sentence","text":"I like the sports field best in our school.","translation":"在我们学校，我最喜欢运动场。","audioResource":"u_057"},{"type":"sentence","text":"Where is James? He is in the library.","translation":"詹姆斯在哪里？他在图书馆。","audioResource":"u_058"},{"type":"sentence","text":"Where is Xiaopu? He is on the sports field.","translation":"小浦在哪里？他在运动场上。","audioResource":"u_059"},{"type":"sentence","text":"Shall we meet in the classroom?","translation":"我们在教室里见面好吗？","audioResource":"u_060"},{"type":"sentence","text":"Sure. Let us meet there then.","translation":"好的，那我们在那里见面吧。","audioResource":"u_061"},{"type":"sentence","text":"The classroom has no computers.","translation":"教室里没有电脑。","audioResource":"u_062"},{"type":"sentence","text":"The classroom does not have any computers.","translation":"教室里没有任何电脑。","audioResource":"u_063"},{"type":"sentence","text":"Green School Bali is special.","translation":"巴厘绿色学校很特别。","audioResource":"u_064"},{"type":"sentence","text":"All its school buildings are made of bamboo.","translation":"它所有的教学楼都是用竹子做的。","audioResource":"u_065"},{"type":"sentence","text":"These bamboo buildings have no walls.","translation":"这些竹子建筑没有墙。","audioResource":"u_066"},{"type":"sentence","text":"They look like big umbrellas.","translation":"它们看起来像大伞。","audioResource":"u_067"},{"type":"sentence","text":"Each building has three floors.","translation":"每栋建筑有三层。","audioResource":"u_068"},{"type":"sentence","text":"Students learn and play in bamboo classrooms, computer rooms, music rooms and art rooms.","translation":"学生们在竹子教室、计算机机房、音乐教室和美术教室里学习和玩耍。","audioResource":"u_069"},{"type":"sentence","text":"I like the library in my school best. It is on the ground floor.","translation":"在学校里我最喜欢图书馆。它在一楼。","audioResource":"u_070"},{"type":"sentence","text":"It looks like a boat.","translation":"它看起来像一条船。","audioResource":"u_071"}]},{"title":"五、作文范文 · My favourite place in the school","items":[{"type":"sentence","text":"I like the library in my school best.","translation":"我最喜欢学校里的图书馆。","audioResource":"u_072"},{"type":"sentence","text":"It is on the ground floor.","translation":"它在一楼。","audioResource":"u_073"},{"type":"sentence","text":"It is very special.","translation":"它非常特别。","audioResource":"u_074"},{"type":"sentence","text":"It looks like a boat.","translation":"它看起来像一条船。","audioResource":"u_071"},{"type":"sentence","text":"The room does not have any chairs or desks.","translation":"这个房间里没有任何椅子和桌子。","audioResource":"u_075"},{"type":"sentence","text":"In the library, I read many interesting books.","translation":"在图书馆里，我读许多有趣的书。","audioResource":"u_076"}],"description":"写作思路：1）我最喜欢的地方是哪里 2）它在哪里 3）它有什么特别之处、看起来像什么 4）我在那里做什么"}],"audioProfile":"en-GB-SoniaNeural","audioAccent":"British English","source":"4AU1整理.doc","shortTitle":"Unit 1"}